    scene back7 with fade:
        size (1280, 720)
        fit "fill"
    if gender == "M":
        show m1:
            zoom 1.0 xalign -0.3 yalign 0.0
            alpha 0.0
            easein 0.3 alpha 1.0
        character "Странно, никого нет, может быть, все-таки санитарный день? Ни охраны, ни библиотекарей."
