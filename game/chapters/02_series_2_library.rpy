label scene17:
    window hide
    with None
    # кат - сцена
    scene seria2 with fade:
        size (1280, 720)
        fit "fill"
    # call predonwload
    $ renpy.pause(delay=6.0, hard=True)
    scene 1back1 with fade:
        size (1280, 720)
        fit "fill"
    stop music fadeout 2.0
